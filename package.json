{
  "name": "@luckymachines/autoloop-sdk",
  "version": "0.2.2",
  "description": "TypeScript SDK for interacting with AutoLoop contracts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "registry:set": "node scripts/registry-config.cjs",
    "registry:show": "node scripts/registry-config.cjs show",
    "registry:local": "node scripts/registry-config.cjs local",
    "registry:staging": "node scripts/registry-config.cjs staging",
    "registry:prod": "node scripts/registry-config.cjs prod",
    "registry:ping": "node scripts/registry-config.cjs ping",
    "publish:registry": "node scripts/publish-registry.cjs",
    "check": "npm run build && npm audit --omit=dev --audit-level=high"
  },
  "peerDependencies": {
    "viem": ">=2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "viem": "^2.46.0"
  },
  "author": "Lucky Machines LLC",
  "license": "MIT"
}
